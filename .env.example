PORT=3000
HOST=127.0.0.1
# Run npm run admin:setup to generate an administrator and a hashed password.
# ADMIN_USER=admin
# ADMIN_PASSWORD_HASH=
# Set true only behind HTTPS in production.
SECURE_COOKIES=false
# DATABASE_PATH=./data/store.db
# Vercel Production only: connect the dedicated Neon database as DATABASE_URL.
# DATABASE_URL=
# Alternative to ADMIN_PASSWORD_HASH for Vercel (private, at least 12 characters):
# ADMIN_PASSWORD=
# Optional private notification address used only when initially seeding Postgres.
# ORDER_NOTIFICATION_EMAIL=
# Private server-only Resend API key. Never use a VITE_ prefix or commit a real key.
# RESEND_API_KEY=
# Verified sending address (the receiving address is editable in admin settings).
# RESEND_FROM=Qadam Flex <orders@qadamflex.bond>
