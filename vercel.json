{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/products/(upload-[a-f0-9-]+\\.(?:jpg|png|webp))",
      "dest": "/api/index?route=media/$1"
    },
    { "src": "/api/(.*)", "dest": "/api/index?route=$1" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
